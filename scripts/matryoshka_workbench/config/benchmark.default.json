{
  "output_root": "output/matryoshka_workbench/benchmarks",
  "experiment_name": "multicorpus_pair_default",
  "python_executable": "python3",
  "seed": 42,
  "catalog_target_uniform": 400,
  "task_counts": {
    "reconstruction": 10,
    "claims": 10,
    "value_redaction": 10,
    "sentence_redaction": 10,
    "contradictions": 10
  },
  "task_generation_policies": {
    "reconstruction": {
      "catalog_multiplier": 18,
      "catalog_min_small": 24,
      "catalog_min_medium": 120,
      "catalog_min_large": 400,
      "catalog_max": 1000
    },
    "claims": {
      "catalog_multiplier": 18,
      "catalog_min_small": 24,
      "catalog_min_medium": 140,
      "catalog_min_large": 320,
      "catalog_max": 800,
      "build_parser_vet_max_claim_rows": 5000,
      "peer_pool_disable_claim_rows": 5000,
      "max_claim_rows_for_minimal_scan": 1600,
      "max_minimal_probe_rows": 600,
      "max_fast_seed_rows": 900,
      "max_ranked_candidate_rows": 1400,
      "max_candidate_case_budget": 600,
      "parser_vet_budget_multiplier": 20,
      "parser_vet_budget_cap": 320,
      "pair_vet_budget_multiplier": 8,
      "pair_vet_budget_cap": 80
    },
    "value_redaction": {
      "catalog_multiplier": 20,
      "catalog_min_small": 24,
      "catalog_min_medium": 140,
      "catalog_min_large": 480,
      "catalog_max": 1200
    },
    "sentence_redaction": {
      "catalog_multiplier": 20,
      "catalog_min_small": 24,
      "catalog_min_medium": 180,
      "catalog_min_large": 480,
      "catalog_max": 1200
    },
    "contradictions": {
      "catalog_multiplier": 18,
      "catalog_min_small": 24,
      "catalog_min_medium": 140,
      "catalog_min_large": 320,
      "catalog_max": 800,
      "peer_pool_disable_claim_rows": 12000,
      "max_claim_rows_for_minimal_scan": 1600,
      "max_seed_claim_catalog": 320,
      "max_ranked_candidate_rows": 1400,
      "max_candidate_case_budget": 600,
      "parser_vet_budget_multiplier": 20,
      "parser_vet_budget_cap": 320,
      "pair_vet_budget_multiplier": 8,
      "pair_vet_budget_cap": 80
    }
  },
  "runner": {
    "mode": "pair",
    "staged_top_docs": 150,
    "retrieval_mode": "staged",
    "raw_use_mode": "validate",
    "max_elapsed_seconds": 0.0,
    "task_overrides": {},
    "use_openai_parser": false,
    "build_vet_claim_queries_with_parser": true,
    "build_vet_contradiction_queries_with_parser": true,
    "build_parser_vet_case_budget": 48,
    "openai_tasks": [],
    "use_llm_digest": false,
    "parser_model": "gpt-4o",
    "llm_model": "gpt-4o-mini",
    "openai_api_key_env": "OPENAI_API_KEY",
    "minimum_score": null,
    "minimum_margin": null,
    "contradiction_propositions_per_class_per_document": 12,
    "contradiction_raw_sentences_per_class_per_document": 4,
    "stop_on_failure": false
  },
  "sampling": {
    "max_cases_per_doc": 2,
    "reconstruction": {
      "min_words": 20,
      "max_words": 140,
      "min_query_words": 24,
      "max_query_words": 180,
      "max_chars": 1400,
      "require_overall_label": "strong",
      "min_distinctive_anchor_count": 25,
      "min_visible_context_words": 18,
      "max_source_excerpt_chars": 480,
      "max_source_excerpt_sentences": 3,
      "neighbor_chunk_radius": 1,
      "max_anchors": 12,
      "max_entities": 8,
      "max_events": 2,
      "max_claims": 2
    },
    "claims": {
      "min_words": 8,
      "max_words": 48,
      "min_query_words": 16,
      "max_query_words": 180,
      "require_structured_source": true,
      "require_target_or_speaker": false,
      "require_nonempty_speaker": false,
      "exclude_generic_roles": true,
      "min_role_fields": 2,
      "include_stance": false,
      "query_style": "contextual"
    },
    "value_redaction": {
      "min_confidence": 0.7,
      "min_query_words": 16,
      "max_query_words": 180,
      "min_label_words": 1,
      "person_min_label_words": 2,
      "max_label_words": 6,
      "max_label_doc_frequency": 2,
      "fallback_max_label_doc_frequency": 4,
      "max_entity_candidates_in_paragraph": 12,
      "allowed_entity_types": [
        "person",
        "location",
        "organization",
        "government"
      ],
      "fallback_entity_types": [
        "organization",
        "government",
        "location",
        "military"
      ],
      "include_locations": true,
      "min_claims_in_paragraph": 0,
      "min_events_in_paragraph": 0,
      "min_relations_in_paragraph": 0,
      "max_chunk_words": 220,
      "min_role_words": 0,
      "fallback_min_role_words": 0,
      "location_min_role_words": 0,
      "max_slot_count": 2,
      "slot_count_decay": 0.5,
      "neighbor_chunk_radius": 1,
      "strict_selected_value_match": false,
      "blocked_labels": [
        "embassy",
        "government",
        "country",
        "people",
        "city",
        "province",
        "president",
        "prime minister",
        "minister",
        "official",
        "delegation"
      ]
    },
    "sentence_redaction": {
      "min_sentence_words": 8,
      "max_sentence_words": 38,
      "min_query_words": 16,
      "max_query_words": 220,
      "min_context_sentence_words": 6,
      "min_claims_in_paragraph": 0,
      "min_events_in_paragraph": 0,
      "min_relations_in_paragraph": 0,
      "min_entity_hits": 0,
      "target_sentence_words": 18,
      "gap_sentence_span": 1,
      "left_context_sentences": 1,
      "right_context_sentences": 1,
      "max_visible_context_sentences": 4,
      "max_visible_context_chars": 560
    },
    "contradictions": {
      "min_words": 8,
      "max_words": 40,
      "min_query_words": 16,
      "max_query_words": 160,
      "require_structured_source": true,
      "require_target_or_speaker": false,
      "min_role_fields": 2,
      "include_stance": false,
      "query_style": "contextual",
      "strategy_order": [
        "numeric",
        "date",
        "negation"
      ]
    }
  }
}
